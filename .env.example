# Copier ce fichier vers .env (jamais commité, voir .gitignore) et adapter les valeurs.

# PostgreSQL (docker-compose.yml)
POSTGRES_PASSWORD=nutriscan_dev
DATABASE_URL=postgresql://nutriscan:nutriscan_dev@localhost:5432/nutriscan

# Cle symetrique de chiffrement des donnees de sante (table utilisateur_allergene).
# Ne jamais utiliser cette valeur d'exemple en dehors d'un environnement de developpement local.
RGPD_ENCRYPTION_KEY=change-moi-en-local

# JWT (API Data / API IA, voir docs/01-cadrage/architecture.md)
# Meme identite client utilisee pour appeler l'une ou l'autre API : simplification
# assumee pour ce projet (une seule identite de service interne).
JWT_SECRET_KEY=change-moi-en-local
API_CLIENT_ID=nutriscan-app
API_CLIENT_SECRET=change-moi-en-local

# JWT de session utilisateur (app/backend, Bloc 3) - secret distinct de
# JWT_SECRET_KEY ci-dessus : un jeton de session utilisateur compromis ne
# doit jamais pouvoir etre rejoue comme jeton de service, et inversement
# (voir app/backend/security.py).
APP_JWT_SECRET_KEY=change-moi-en-local

# API IA : ou joindre l'API Data (Bloc 1) pour recuperer produits/recettes
DATA_API_BASE_URL=http://localhost:8010

# Monitoring applicatif (Grafana, Bloc 3) - voir docs/04-bloc3-app/monitoring-app.md
GRAFANA_ADMIN_PASSWORD=nutriscan_dev
